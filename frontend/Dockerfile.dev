# Development image used by docker-compose.yml so `docker compose up` brings up
# the React SPA alongside the rest of the stack with a single command.
FROM node:20-slim

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 5173

# --host 0.0.0.0 so the Vite dev server is reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
