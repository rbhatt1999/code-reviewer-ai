# --- Database (local dev connects to the Dockerised Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cra
DATABASE_PASSWORD=cra
DATABASE_NAME=code_reviewer_ai_development
DATABASE_NAME_TEST=code_reviewer_ai_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama (local LLM runtime — Increment 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# --- DeepSeek (cloud LLM — demo swap; ReviewService defaults to this client) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=__set_me__

# --- Rails ---
RAILS_ENV=development
SECRET_KEY_BASE=__run_bin_rails_secret__
JWT_SECRET_KEY=__run_bin_rails_secret__

# --- Sidekiq Web UI (HTTP Basic Auth — Increment 4) ---
SIDEKIQ_WEB_USER=admin
SIDEKIQ_WEB_PASSWORD=__change_me__

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Limits ---
MAX_UPLOAD_BYTES=5242880

# --- Submission blob storage ---
SUBMISSION_BLOB_ROOT=storage/submissions

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_BASE_URL=ws://localhost:3000/cable

# --- ngrok (optional — only needed to expose the GitHub webhook publicly
# for a live demo; see README "Exposing the webhook publicly"). Free token:
# https://dashboard.ngrok.com/get-started/your-authtoken ---
NGROK_AUTHTOKEN=__set_me__
