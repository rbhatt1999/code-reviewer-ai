# --- Database (local dev connects to the Dockerised Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=cra
DATABASE_PASSWORD=cra
DATABASE_NAME=code_reviewer_ai_development
DATABASE_NAME_TEST=code_reviewer_ai_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama (local LLM runtime — Increment 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# --- Rails ---
RAILS_ENV=development
SECRET_KEY_BASE=__run_bin_rails_secret__
JWT_SECRET_KEY=__run_bin_rails_secret__

# --- Sidekiq Web UI (HTTP Basic Auth — Increment 4) ---
SIDEKIQ_WEB_USER=admin
SIDEKIQ_WEB_PASSWORD=__change_me__

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Limits ---
MAX_UPLOAD_BYTES=5242880

# --- Submission blob storage ---
SUBMISSION_BLOB_ROOT=storage/submissions

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_BASE_URL=ws://localhost:3000/cable
